<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WVU & Hockey Weekly Checklist</title>
  <style>
    :root {
      --wvu-blue: #002855;
      --wvu-gold: #EAAA00;
      --bg: #F4F6F9;
      --card-bg: #FFFFFF;
      --text: #1C2024;
      --muted: #606770;
      --border: #E1E4E8;
      --success: #2E7D32;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 16px;
      display: flex;
      justify-content: center;
    }
    .app {
      max-width: 600px;
      width: 100%;
    }
    header {
      background: var(--wvu-blue);
      color: white;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 16px;
      border-bottom: 4px solid var(--wvu-gold);
    }
    h1 { margin: 0 0 6px 0; font-size: 1.4rem; }
    p { margin: 0; font-size: 0.9rem; opacity: 0.85; }

    .controls {
      background: var(--card-bg);
      padding: 14px 16px;
      border-radius: 10px;
      border: 1px solid var(--border);
      margin-bottom: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .control-group {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.95rem;
      font-weight: 600;
    }
    select, button {
      font-family: inherit;
      padding: 6px 12px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--bg);
      font-weight: 500;
      cursor: pointer;
    }
    .reset-btn {
      background: var(--wvu-gold);
      color: var(--wvu-blue);
      border: none;
      font-weight: bold;
      width: 100%;
      padding: 10px;
      margin-top: 4px;
    }

    .day-card {
      background: var(--card-bg);
      border-radius: 10px;
      border: 1px solid var(--border);
      padding: 14px 16px;
      margin-bottom: 12px;
    }
    .day-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--wvu-blue);
      margin-bottom: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .badge {
      font-size: 0.75rem;
      padding: 2px 8px;
      border-radius: 12px;
      background: #EBF3FE;
      color: #0055B8;
    }

    .task-list { list-style: none; padding: 0; margin: 0; }
    .task-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
      border-bottom: 1px solid #F0F2F5;
    }
    .task-item:last-child { border-bottom: none; }
    .task-item input[type="checkbox"] {
      width: 18px;
      height: 18px;
      cursor: pointer;
    }
    .task-text { font-size: 0.95rem; flex-grow: 1; }
    .completed .task-text {
      text-decoration: line-through;
      color: var(--muted);
    }
    .note {
      font-size: 0.8rem;
      color: var(--muted);
      font-style: italic;
      margin-top: 4px;
    }
  </style>
</head>
<body>

<div class="app">
  <header>
    <h1>WVU & Hockey Weekly Checklist</h1>
    <p>Keep track of classes, practices, assignments, and study hours.</p>
  </header>

  <div class="controls">
    <div class="control-group">
      <span>Weekend Schedule:</span>
      <select id="weekendSelect" onchange="updateWeekendType()">
        <option value="hockey">Hockey Games Weekend</option>
        <option value="off">Off Weekend</option>
      </select>
    </div>
    <div class="control-group">
      <span>Chapel Cycle:</span>
      <button onclick="toggleChapelWeek()" id="chapelBtn">Chapel This Week</button>
    </div>
    <button class="reset-btn" onclick="resetWeek()">Reset Checklist for New Week</button>
  </div>

  <div id="checklist"></div>
</div>

<script>
  let state = JSON.parse(localStorage.getItem('wvu_checklist')) || {
    chapelWeek: true,
    weekendType: 'hockey',
    checks: {}
  };

  function saveState() {
    localStorage.setItem('wvu_checklist', JSON.stringify(state));
  }

  function toggleChapelWeek() {
    state.chapelWeek = !state.chapelWeek;
    saveState();
    render();
  }

  function updateWeekendType() {
    state.weekendType = document.getElementById('weekendSelect').value;
    saveState();
    render();
  }

  function toggleCheck(id) {
    state.checks[id] = !state.checks[id];
    saveState();
    render();
  }

  function resetWeek() {
    if (confirm("Reset all checked items for a new week?")) {
      state.checks = {};
      saveState();
      render();
    }
  }

  function render() {
    document.getElementById('weekendSelect').value = state.weekendType;
    document.getElementById('chapelBtn').innerText = state.chapelWeek ? "Chapel This Week (Active)" : "No Chapel This Week";

    const mondayDone = !!state.checks['mon_study'];

    const schedule = [
      {
        day: 'Monday',
        tasks: [
          { id: 'mon_study', text: 'Go to study hours' }
        ]
      },
      {
        day: 'Tuesday',
        tasks: [
          { id: 'tue_practice', text: 'Go to hockey practice' },
          { id: 'tue_nof1', text: 'Complete N-of-1 assignment' }
        ]
      },
      {
        day: 'Wednesday',
        tasks: [
          ...(state.chapelWeek ? [{ id: 'wed_chapel', text: 'Go to Chapel', badge: 'Every Other Week' }] : []),
          { 
            id: 'wed_study', 
            text: mondayDone ? 'Study hours completed on Monday (Backup not needed)' : 'Backup Study Hours (Monday hours were missed)',
            disabled: mondayDone 
          }
        ]
      },
      {
        day: 'Thursday',
        tasks: [
          { id: 'thu_hw', text: 'Complete homework for hockey team' },
          { id: 'thu_practice', text: 'Go to hockey practice' }
        ]
      },
      {
        day: 'Friday',
        tasks: [
          { id: 'fri_hw', text: 'Complete Friday night homework' },
          { 
            id: 'fri_prep', 
            text: state.weekendType === 'hockey' 
              ? 'Prepare gear & pack for Hockey Weekend' 
              : 'Prepare and organize for Off Weekend' 
          }
        ]
      }
    ];

    let html = '';
    schedule.forEach(d => {
      html += `<div class="day-card">
        <div class="day-title">${d.day}</div>
        <ul class="task-list">`;
      
      d.tasks.forEach(t => {
        const isChecked = !!state.checks[t.id];
        const isDisabled = t.disabled;
        html += `
          <li class="task-item ${isChecked ? 'completed' : ''}">
            <input type="checkbox" 
                   ${isChecked ? 'checked' : ''} 
                   ${isDisabled ? 'disabled' : ''} 
                   onclick="toggleCheck('${t.id}')">
            <span class="task-text">${t.text}</span>
            ${t.badge ? `<span class="badge">${t.badge}</span>` : ''}
          </li>`;
      });

      html += `</ul></div>`;
    });

    document.getElementById('checklist').appendChild ? document.getElementById('checklist').innerHTML = html : null;
  }

  render();
</script>
</body>
</html>
